{"case": "fenced JSON reply when tools were offered", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "```json\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n```", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
