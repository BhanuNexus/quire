{"case": "imagined tool response is cut", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n</tool_call>\n<tool_response>\n{\"temperature\": 26.1}\n</tool_response>\nIt is 26 degrees.", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
