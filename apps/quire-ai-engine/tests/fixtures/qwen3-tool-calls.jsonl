{"_comment": "Replies modelled on Qwen3 function-calling examples (qwen.readthedocs.io, Function Calling: get_current_temperature, get_temperature_date) with the mistakes small models make. Each case is fed to ReplyParser in 3-character pieces."}
{"case": "qwen docs: two calls, as published", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n</tool_call>\n<tool_call>\n{\"name\": \"get_temperature_date\", \"arguments\": {\"location\": \"San Francisco, CA, USA\", \"date\": \"2024-10-01\"}}\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}, {"call": {"name": "get_temperature_date", "arguments": {"location": "San Francisco, CA, USA", "date": "2024-10-01"}}}]}
{"case": "text before the call", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "Let me check the weather.\n<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n</tool_call>", "expect": [{"text": "Let me check the weather.\n"}, {"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
{"case": "single quotes", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{'name': 'get_current_temperature', 'arguments': {'location': 'San Francisco, CA, USA'}}\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
{"case": "code fence inside the tags", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n```json\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n```\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
{"case": "trailing text inside the tags", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\nThis gets the temperature.\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
{"case": "trailing text after the call", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n</tool_call>\nI will tell you once I know.", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}, {"text": "I will tell you once I know."}]}
{"case": "two calls in one block", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n{\"name\": \"get_temperature_date\", \"arguments\": {\"location\": \"San Francisco, CA, USA\", \"date\": \"2024-10-01\"}}\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}, {"call": {"name": "get_temperature_date", "arguments": {"location": "San Francisco, CA, USA", "date": "2024-10-01"}}}]}
{"case": "missing closing tag before the next call", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}}\n<tool_call>\n{\"name\": \"get_temperature_date\", \"arguments\": {\"location\": \"San Francisco, CA, USA\", \"date\": \"2024-10-01\"}}\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}, {"call": {"name": "get_temperature_date", "arguments": {"location": "San Francisco, CA, USA", "date": "2024-10-01"}}}]}
{"case": "missing closing brace", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_current_temperature\", \"arguments\": {\"location\": \"San Francisco, CA, USA\"}\n</tool_call>", "expect": [{"call": {"name": "get_current_temperature", "arguments": {"location": "San Francisco, CA, USA"}}}]}
{"case": "trailing commas and True", "tools": ["get_current_temperature", "get_temperature_date"], "reply": "<tool_call>\n{\"name\": \"get_temperature_date\", \"arguments\": {\"location\": \"San Francisco, CA, USA\", \"date\": \"2024-10-01\",},}\n</tool_call>", "expect": [{"call": {"name": "get_temperature_date", "arguments": {"location": "San Francisco, CA, USA", "date": "2024-10-01"}}}]}
